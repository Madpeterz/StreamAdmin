# StreamAdmin 3.0 production settings, read by docker-compose.yml (copy to .env next to it, or set the
# same names as stack environment variables in Portainer). Never commit the real .env.
# The dev stack uses .env.dev.example instead.

# --- Required ---------------------------------------------------------------------------------------
# Image version to run, example 3.0.0
STREAMADMIN_TAG=
# docker run --rm madpeter/streamadmin:<tag> php artisan key:generate --show
# A value that is not a valid key (wrong length, no "base64:" prefix) is not rejected: it is used as the seed
# for a valid key, the same value always giving the same key. Use a long random value, and keep it: changing
# it signs everyone out and makes encrypted values unreadable.
APP_KEY=
# Public https address of the cloudflared hostname, no trailing slash.
# Every URL the app creates (reset links sent in-world, redirects, assets) uses this, never the request's host,
# so it must be the address staff use
APP_URL=https://streamadmin.example.com
# Password of the streamadminDBuser database user (MariaDB and the app)
DB_PASSWORD=
# Password for Valkey (sessions, cache, queues)
VALKEY_PASSWORD=

# --- Optional ---------------------------------------------------------------------------------------
APP_NAME=StreamAdmin
# Docker network shared by cloudflared and the app (created by docker-compose.cloudflared.yml, see .env.cloudflared.example)
TUNNEL_NETWORK=cloudf
# Turn off on all but one app container (in-world queues, nightly spreadsheet)
SCHEDULER_ENABLED=true
EXPORT_MAX_BACKUPS=14
# Trusted reverse proxies: "*" (the container is only reachable through the tunnel) or comma separated addresses
TRUSTED_PROXIES=*
LOG_LEVEL=warning
SESSION_LIFETIME=120
# phpMyAdmin (docker compose --profile tools up -d), bound to 127.0.0.1 only
PMA_PORT=8881
# Upgrading from 2.0.x: name of the existing database volume (docker volume ls), see docs/RELEASE_3.0.0.md
# DB_VOLUME=streamadmin_streamadmin-db

# --- Set by the image (listed for reference) ----------------------------------------------------------
# AUTORUN_ENABLED=true                   migrate + `php artisan optimize` (config/route/view/event cache) on start
# PHP_OPCACHE_VALIDATE_TIMESTAMPS=0      code changes need a new image
# PHP_OPCACHE_MEMORY_CONSUMPTION=256
# PHP_OPCACHE_MAX_ACCELERATED_FILES=20000
