# Copy to .env (next to docker-compose.cloudflared.yml) and fill in. Never commit the real .env.
# Image version to run, example 2.0.1.1
STREAMADMIN_TAG=
# Public url of the cloudflared tunnel hostname, with a ending /
SITE_URL=https://streamadmin.example.com/
# Password for the streamadmin database user (used by MariaDB and the website)
SQL_DB_PASS=
# Optional
SITE_NAME=Streamadmin
PMA_PORT=8881
