# Settings for docker-compose.cloudflared.yml only (the tunnel connector).
#
#   cp .env.cloudflared.example .env.cloudflared
#   docker compose -f docker-compose.cloudflared.yml --env-file .env.cloudflared up -d

# Tunnel token: Zero Trust dashboard -> Networks -> Tunnels -> your tunnel -> Install connector
TUNNEL_TOKEN=
# Docker network shared with the app stack. Must match TUNNEL_NETWORK in the app's .env
TUNNEL_NETWORK=cloudf
