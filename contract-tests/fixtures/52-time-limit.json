{
    "scenario": "52-time-limit",
    "description": "Rental time limit enforcement on HUD and vendor renewals",
    "seeds": [
        "catalog",
        "hud",
        "time-limit"
    ],
    "steps": [
        {
            "id": "hudconfig",
            "request": {
                "method": "POST",
                "path": "/hud.php/Config/Hudconfig",
                "headers": {
                    "X-SecondLife-Shard": "Production"
                },
                "post": {
                    "version": "2.0.1.2",
                    "mode": "api",
                    "objectuuid": "0b1ec700-0000-4000-8000-000000000001",
                    "regionname": "Contract Region",
                    "ownerkey": "c11e0000-0000-4000-8000-000000000001",
                    "ownername": "Contract Client",
                    "pos": "128,128,25",
                    "objectname": "Contract object",
                    "objecttype": "vendor"
                }
            },
            "response": {
                "http_status": 200,
                "content_type": "text/html",
                "body": {
                    "status": "1",
                    "message": "Get config [ok]",
                    "module": "Config",
                    "area": "Hudconfig",
                    "AllowDiscord": "1",
                    "AllowGroup": "1",
                    "AllowDetails": "1",
                    "AllowRenewal": "0",
                    "GroupLink": "secondlife:///app/group/9c000000-0000-4000-8000-000000000009/about",
                    "DiscordLink": "https://discord.contract.test/invite"
                }
            }
        },
        {
            "id": "hud_renew_blocked",
            "request": {
                "method": "POST",
                "path": "/hud.php/Rentals/Renew",
                "headers": {
                    "X-SecondLife-Shard": "Production"
                },
                "post": {
                    "version": "2.0.1.2",
                    "mode": "api",
                    "objectuuid": "0b1ec700-0000-4000-8000-000000000001",
                    "regionname": "Contract Region",
                    "ownerkey": "c11e0000-0000-4000-8000-000000000001",
                    "ownername": "Contract Client",
                    "pos": "128,128,25",
                    "objectname": "Contract object",
                    "objecttype": "vendor",
                    "avatarUUID": "c11e0000-0000-4000-8000-000000000001",
                    "avatarName": "Contract Client",
                    "rentalUid": "rentActv",
                    "amountpaid": "500",
                    "transactionUUID": "7a000000-0000-4000-8000-000000000001"
                }
            },
            "response": {
                "http_status": 200,
                "content_type": "text/html",
                "body": {
                    "status": "0",
                    "message": "Hud renewals are disabled while the rental time limit is enforced",
                    "module": "Rentals",
                    "area": "Renew"
                }
            }
        },
        {
            "id": "vendor_renew_ok",
            "request": {
                "method": "POST",
                "path": "/api.php/Renew/Renewnow",
                "headers": {
                    "X-SecondLife-Shard": "Production"
                },
                "post": {
                    "version": "2.0.1.2",
                    "mode": "api",
                    "objectuuid": "0b1ec700-0000-4000-8000-000000000001",
                    "regionname": "Contract Region",
                    "ownerkey": "00000000-0000-0000-0000-000000000000",
                    "ownername": "System",
                    "pos": "128,128,25",
                    "objectname": "Contract object",
                    "objecttype": "vendor",
                    "avatarUUID": "c11e0000-0000-4000-8000-000000000001",
                    "avatarName": "Contract Client",
                    "rentalUid": "rentActv",
                    "amountpaid": "500"
                }
            },
            "response": {
                "http_status": 200,
                "content_type": "text/html",
                "body": {
                    "status": "1",
                    "message": "Payment accepted there is now: {{dur:20160~60}} remaining you will next need to renew {{datetime}}",
                    "module": "Renew",
                    "area": "Renewnow",
                    "owner_payment": 0,
                    "credit-return": 0,
                    "credit-remaining": 0
                }
            }
        },
        {
            "id": "vendor_renew_over_limit",
            "request": {
                "method": "POST",
                "path": "/api.php/Renew/Renewnow",
                "headers": {
                    "X-SecondLife-Shard": "Production"
                },
                "post": {
                    "version": "2.0.1.2",
                    "mode": "api",
                    "objectuuid": "0b1ec700-0000-4000-8000-000000000001",
                    "regionname": "Contract Region",
                    "ownerkey": "00000000-0000-0000-0000-000000000000",
                    "ownername": "System",
                    "pos": "128,128,25",
                    "objectname": "Contract object",
                    "objecttype": "vendor",
                    "avatarUUID": "c11e0000-0000-4000-8000-000000000001",
                    "avatarName": "Contract Client",
                    "rentalUid": "rentActv",
                    "amountpaid": "500"
                }
            },
            "response": {
                "http_status": 200,
                "content_type": "text/html",
                "body": {
                    "status": "0",
                    "message": "payment not accepted (would go over limit for remaining time on rental)",
                    "module": "Renew",
                    "area": "Renewnow"
                }
            }
        },
        {
            "id": "vendor_renew_month_over_limit",
            "request": {
                "method": "POST",
                "path": "/api.php/Renew/Renewnow",
                "headers": {
                    "X-SecondLife-Shard": "Production"
                },
                "post": {
                    "version": "2.0.1.2",
                    "mode": "api",
                    "objectuuid": "0b1ec700-0000-4000-8000-000000000001",
                    "regionname": "Contract Region",
                    "ownerkey": "00000000-0000-0000-0000-000000000000",
                    "ownername": "System",
                    "pos": "128,128,25",
                    "objectname": "Contract object",
                    "objecttype": "vendor",
                    "avatarUUID": "c11e0000-0000-4000-8000-000000000002",
                    "avatarName": "Other Client",
                    "rentalUid": "rentExpd",
                    "amountpaid": "900"
                }
            },
            "response": {
                "http_status": 200,
                "content_type": "text/html",
                "body": {
                    "status": "0",
                    "message": "payment not accepted (would go over limit for remaining time on rental)",
                    "module": "Renew",
                    "area": "Renewnow"
                }
            }
        }
    ]
}
